NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/noc_console
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:5173
# Máximo de eventos que se conservan embebidos en Link.timeline (el histórico completo vive en Incidence_Log)
TIMELINE_MAX=500
APP_TIMEZONE=America/Santiago
TRUST_PROXY=0
# Minutos antes del cambio de turno en que ya se propone abrir el turno que entra (0–120)
TOLERANCIA_APERTURA_MIN=30
# Integración con iMaster NCE (SOLO LECTURA). Ver README → «Conexión con iMaster NCE».
NCE_ENABLED=false
NCE_BASE_URL=
NCE_USERNAME=
NCE_PASSWORD=
NCE_TLS_VERIFY=true
# NCE_CA_FILE=./config/nce-ca.pem
NCE_POLL_SECONDS=60
NCE_TIMEOUT_MS=15000
NCE_PROFILE=config/nce.perfil.ejemplo.json
NCE_MAPPINGS=config/nce.correspondencia.ejemplo.json
# Documentos adjuntos a las alarmas (procedimientos). Carpeta donde se guardan y tamaño máximo por archivo
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=15
# Password de los usuarios creados por el seed
SEED_PASSWORD=ChangeMe123!
